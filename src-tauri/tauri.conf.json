{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyNotes",
  "version": "0.1.0",
  "identifier": "app.easynotes.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EasyNotes",
        "width": 340,
        "height": 440,
        "minWidth": 340,
        "minHeight": 440,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
